# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# UPSTREAM_API_URL: Optional custom movie catalog/media API base URL.
# Defaults automatically to https://mumowatch.ai.studio when unset.
UPSTREAM_API_URL=""

# UPSTREAM_API_KEY: Optional Bearer token for a user-configured upstream API.
UPSTREAM_API_KEY=""
